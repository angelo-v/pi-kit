# Missing rdfs:label on Book2, missing author on Book1
@prefix ex:   <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:Book1
  a ex:Book ;
  rdfs:label "The Semantic Web Primer" .

ex:Book2
  a ex:Book ;
  ex:author ex:Author1 .

ex:Author1
  a ex:Author ;
  rdfs:label "Alice" .
