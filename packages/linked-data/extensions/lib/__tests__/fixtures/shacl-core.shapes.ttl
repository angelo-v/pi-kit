@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix ex:  <http://example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:BookShape
  a sh:NodeShape ;
  sh:targetClass ex:Book ;
  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Every book must have an rdfs:label." ;
  ] ;
  sh:property [
    sh:path ex:author ;
    sh:minCount 1 ;
    sh:class ex:Author ;
    sh:message "Every book must have at least one ex:author of type ex:Author." ;
  ] .

ex:AuthorShape
  a sh:NodeShape ;
  sh:targetClass ex:Author ;
  sh:property [
    sh:path rdfs:label ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
    sh:message "Every author must have an rdfs:label." ;
  ] .
